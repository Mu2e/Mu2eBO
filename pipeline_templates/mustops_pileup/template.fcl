#include "Production/JobConfig/pileup/MuStopPileup.fcl"

# Muon-stop pileup stage for the IPA BO line: resamples the same TargetStops
# (concat MuminusStopsCat) as mustops_ce, but runs the capture-product
# generators (muonCaptureProtonGenTool + deuteron/neutron/photon/RMC/gamma + DIO)
# and propagates them through the detector -> StrawGasStep (tracker Edep). The
# IPA geom overlay travels with this stage via --code so the absorber geometry
# is what shapes the proton flux into the tracker.
#   physics.filters.TargetStopResampler.fileNames is filled by mu2ejobdef
#   --auxinput=1:physics.filters.TargetStopResampler.fileNames:LIST (set in
#   pipeline.py cmd_submit, identical to mustops_ce).

# FTFP_BERT physics list -- match mustops_ce / mubeam (hadronic capture-proton
# transport quality). See wiki concepts/g4-speed-knobs.md.
physics.producers.g4run.physics.physicsListName: "FTFP_BERT"

services.SeedService.baseSeed: 1

outputs.Output.fileName: "dts.owner.MuStopPileup.version.sequencer.art"

services.GeometryService.inputFile:  "__GEOM_FILE__"
# DS field ON (protons propagate to the tracker) -- same map as mustops_ce.
services.GeometryService.bFieldFile: "Offline/Mu2eG4/geom/bfgeom_v01.txt"

# Required: the prolog leaves this @nil so we must override or art aborts at
# ResamplingMixer construction. Matches mustops_ce.
physics.filters.TargetStopResampler.mu2e.MaxEventsToSkip: 100720
