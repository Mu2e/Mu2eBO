    "njobs": 1,
    "memory_mb": 3000,
    "quorum": 1.0
   }
  },
  {
   "step": "plot",
   "kit": "anakit",
   "entry": null,
   "files": [],
   "files_from": [
    "nts"
   ],
   "params": {},
   "params_from": {},
   "fixed": {
    "analysis": "trigger_efficiency_ntuple",
    "trigger_paths": "apr_TrkDe_80m70p, cpr_TrkDe_80m70p"
   }
  }
 ],
