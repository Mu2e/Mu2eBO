#include "Production/JobConfig/pileup/MuonStopSelector.fcl"

# MuonStopSelector reads source.fileNames (filled by prodtools json2jobdef
# from the entry's input_data/inloc fields -- was mu2ejobdef --inputs before
# the prodtools switch) and writes mu-/mu+ TargetStops into separate art
# files. No G4, no geometry dependency, so the BO geom overlay is NOT
# shipped with this stage.

outputs.muminusout.fileName: "sim.owner.MuminusStopsCat.version.sequencer.art"
outputs.muplusout.fileName:  "sim.owner.MuplusStopsCat.version.sequencer.art"
