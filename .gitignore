# =============================================================================
# Runtime state (Python, build, etc.)
# =============================================================================
.venv*
.claude/
build/
__pycache__/
*.pyc
.env

# =============================================================================
# Driver runtime logs and scratch
# =============================================================================
*.log
*.root
*.art

# =============================================================================
# LaTeX build intermediates (docs/slides/ beamer deck; moved there 2026-07-17)
docs/slides/*.aux
docs/slides/*.nav
docs/slides/*.out
docs/slides/*.snm
docs/slides/*.toc
docs/slides/*.vrb

# =============================================================================
# Editor / OS cruft
# =============================================================================
*~
#*#
.#*

# =============================================================================
# Leaderboard maintenance sidecars (operator-made, originals are committed):
# pre-cleanup snapshots (<file>.tsv.bak.YYYYMMDD_HHMMSS) and flagged-row
# quarantine sidecars (<file>.broken.tsv, see wiki/datasets/leaderboards.md).
# Not the pending-BO queue -- that has its own section below.
# =============================================================================
*.bak
*.bak_*
*.bak.*
*.bak-*
*.broken.tsv

# =============================================================================
# Runtime locks (cross-process file locks; anchors live in locks/)
locks/
# =============================================================================
*.lock

# =============================================================================
# CVMFS / external sub-repos (vendored with their own .git)
# =============================================================================
backing
runs
Run1BAna/

# =============================================================================
# Pending-BO in-flight queue (mutates on every iteration; not a durable record)
# =============================================================================
pending_bo_*.tsv
/data/

# =============================================================================
# LaTeX build artifacts (beamer decks in docs/; .tex and .pdf are tracked)
# =============================================================================
docs/*.aux
docs/*.nav
docs/*.out
docs/*.snm
docs/*.toc

# subagent-driven-development scratch workspace
.superpowers/

# superpowers specs and plans stay local (not published); files already on main stay tracked
docs/superpowers/
